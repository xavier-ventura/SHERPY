MCP_URL=            # endpoint del MCP de Sherpas
MCP_TOKEN=          # Bearer token del MCP de Sherpas
TEAM_KEY=
# Orígenes del frontend (p. ej. https://tu-app.lovable.app), separados por comas. "*" = todos
CORS_ORIGINS=*
# Voz (ElevenLabs Custom LLM)
VOICE_API_KEY=      # secreto que ElevenLabs enviará como Bearer (opcional)
DEFAULT_CASE_ID=    # familia por defecto si ElevenLabs no indica case_id
FINNHUB_API_KEY=     # finnhub.io (gratis): cotizaciones en tiempo real
# Envío de resúmenes por email (opcional; sin esto /api/send-summary devuelve vista previa)
SMTP_HOST=          # p. ej. smtp.gmail.com
SMTP_PORT=587       # 587 STARTTLS o 465 SSL
SMTP_USER=
SMTP_PASSWORD=      # en Gmail: contraseña de aplicación
SMTP_FROM=          # opcional, por defecto SMTP_USER
# Envío por WhatsApp con Twilio (opcional; sin esto se devuelve un enlace wa.me)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=   # p. ej. +14155238886 (sandbox de Twilio)
